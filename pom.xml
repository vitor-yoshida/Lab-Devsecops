<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
   pom.xml - Arquivo de configuracao do Maven (o "gerenciador de receitas"
   do projeto Java). Ele diz:
     1) Quais bibliotecas (dependencias) a aplicacao usa;
     2) Quais ferramentas rodam durante o build (aqui: SpotBugs + FindSecBugs).

   ATENCAO: varias dependencias abaixo estao PROPOSITALMENTE DESATUALIZADAS.
   Elas possuem falhas de seguranca publicas (CVEs) para que as ferramentas
   Syft e Grype tenham o que encontrar durante o laboratorio.
   NUNCA use estas versoes em um projeto real.
  ===========================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- O "pai" traz as configuracoes prontas do Spring Boot.
         Usamos a versao 2.7.5, que ja e antiga (mais achados no SCA). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.5</version>
        <relativePath/>
    </parent>

    <!-- Identidade do nosso projeto -->
    <groupId>br.com.labdevsecops</groupId>
    <artifactId>app-vulneravel</artifactId>
    <version>1.0.0</version>
    <name>Aplicacao Vulneravel - Lab DevSecOps</name>
    <description>Aplicacao Java intencionalmente insegura para o laboratorio de DevSecOps</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Forca TODAS as bibliotecas do Log4j2 para a versao 2.14.1.
             Essa e a versao do famoso "Log4Shell" (CVE-2021-44228). -->
        <log4j2.version>2.14.1</log4j2.version>

        <!-- Versoes das ferramentas de analise estatica (SAST) -->
        <versao.spotbugs.plugin>4.8.6.4</versao.spotbugs.plugin>
        <versao.findsecbugs>1.13.0</versao.findsecbugs>
    </properties>

    <dependencies>

        <!-- ============================================================
             BIBLIOTECAS NORMAIS (necessarias para a aplicacao funcionar)
             ============================================================ -->

        <!-- Cria o servidor web e permite criar rotas HTTP (/usuario, /busca...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Permite conversar com banco de dados usando JDBC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- ============================================================
             BIBLIOTECAS VULNERAVEIS DE PROPOSITO (alvo do Syft + Grype)
             ============================================================ -->

        <!-- Banco de dados em memoria.
             VULNERAVEL: a versao 1.4.200 tem CVE-2021-42392 e CVE-2022-23221
             (execucao remota de codigo). Corrigido a partir da 2.2.220. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>1.4.200</version>
        </dependency>

        <!-- Biblioteca de logs.
             VULNERAVEL: 2.14.1 e a versao do "Log4Shell" (CVE-2021-44228),
             nota 10.0 de gravidade. Corrigido na 2.17.1+. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.14.1</version>
        </dependency>

        <!-- Utilitarios de colecoes (listas, mapas).
             VULNERAVEL: 3.2.1 tem CVE-2015-7501 (desserializacao insegura). -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.1</version>
        </dependency>

        <!-- Biblioteca de upload de arquivos.
             VULNERAVEL: 1.3.1 tem CVE-2016-1000031 (execucao remota de codigo). -->
        <dependency>
            <groupId>commons-fileupload</groupId>
            <artifactId>commons-fileupload</artifactId>
            <version>1.3.1</version>
        </dependency>

        <!-- Leitor de arquivos YAML.
             VULNERAVEL: 1.28 tem CVE-2022-1471 (desserializacao insegura). -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>1.28</version>
        </dependency>

    </dependencies>

    <build>
        <!-- Nome fixo do arquivo .jar gerado, para simplificar o Dockerfile -->
        <finalName>app-vulneravel</finalName>

        <plugins>

            <!-- Plugin que empacota tudo em um .jar executavel -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- ============================================================
                 IMPORTANTE PARA O LABORATORIO FUNCIONAR
                 A partir do Java 9, o compilador junta textos ("a" + b) de um
                 jeito novo e otimizado (invokedynamic). O problema: o
                 FindSecBugs PERDE O RASTRO do dado do usuario nesse formato e
                 deixa de encontrar SQL Injection, XSS e Command Injection.

                 A opcao -XDstringConcat=inline manda o compilador usar o jeito
                 antigo (StringBuilder), que o FindSecBugs entende.
                 Sem esta configuracao o estagio 1 do pipeline encontra quase
                 nada e a demonstracao perde a graca.
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-XDstringConcat=inline</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- ============================================================
                 ESTAGIO 1 DO PIPELINE: SAST
                 SpotBugs le o codigo compilado procurando bugs.
                 FindSecBugs e um "pacote de regras de seguranca" que ensina
                 o SpotBugs a encontrar SQL Injection, XSS, senha no codigo etc.
                 ============================================================ -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${versao.spotbugs.plugin}</version>
                <configuration>
                    <!-- Max = analise mais profunda (um pouco mais lenta) -->
                    <effort>Max</effort>
                    <!-- Low = reporta ate os achados de baixa confianca -->
                    <threshold>Low</threshold>
                    <!-- Gera tambem um relatorio HTML bonito para apresentar -->
                    <htmlOutput>true</htmlOutput>
                    <xmlOutput>true</xmlOutput>
                    <!-- MODO RELATORIO: nao derruba o build quando acha algo.
                         Assim o pipeline continua ate o ultimo estagio. -->
                    <failOnError>false</failOnError>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${versao.findsecbugs}</version>
                        </plugin>
                    </plugins>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
